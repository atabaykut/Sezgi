datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Misafir {
  id          String        @id
  adSoyad     String
  pasaportNo  String        @map("pasaport_no")
  email       String
  Rezervasyon Rezervasyon[]

  @@map("misafirler")
}

model Rezervasyon {
  id            String   @id
  rezervasyonNo String   @unique
  misafirId     String
  varisTarihi   DateTime
  transferNotu  String?
  Misafir       Misafir  @relation(fields: [misafirId], references: [id])

  @@map("rezervasyonlar")
}
